# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status -o env` after `pnpm db:start`.

# Supabase — browser-safe (RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. Used by jobs/webhooks with explicit org_id filters. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for scripts (seed, db tests, manifest validation). Local Supabase default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public site URL (invite links, auth redirects)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Shared secret that pg_cron sends to /api/jobs/* (ADR 0004). Generate a long random value.
JOB_SECRET=

# AI (Phase 3+) — model ids come from env, never hardcoded (ARCHITECTURE.md)
# ANTHROPIC_API_KEY=
# AI_MODEL_ASSISTANT=claude-sonnet-5
# AI_MODEL_FAST=claude-haiku-4-5
