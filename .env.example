# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status -o env` after `pnpm db:start`.

# Supabase — browser-safe (RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. Used by jobs/webhooks with explicit org_id filters. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for scripts (seed, db tests, manifest validation). Local Supabase default shown.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public site URL (invite links, auth redirects)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Shared secret that pg_cron sends to /api/jobs/* (ADR 0004). Generate a long random value.
JOB_SECRET=

# AI (Phase 3+, ADR 0024) — model ids come from env, never hardcoded (ARCHITECTURE.md).
# OpenAI is used when OPENAI_API_KEY is set; with no key at all, the assistant answers common
# questions straight from your data (no AI). AI_PROVIDER (openai | groq | anthropic) forces one when
# several keys are present.
# OPENAI_API_KEY=
# AI_PROVIDER=openai
# Groq instead (OpenAI-compatible; also its Whisper for voice notes): GROQ_API_KEY=, AI_PROVIDER=groq
# TODO(verify) prices.
# GROQ_API_KEY=
# Groq defaults: assistant openai/gpt-oss-120b, fast qwen/qwen3.8-27b; a request with a photo always goes to
# GROQ_VISION_MODEL (default qwen/qwen3.8-27b). On a 429 (per-minute token limit) a text request is retried
# once on the other of the two, or on GROQ_FALLBACK_MODEL (empty = off).
# AI_MODEL_ASSISTANT=gpt-5-mini
# AI_MODEL_FAST=gpt-5-nano
# AI_REASONING_EFFORT=low
# Prices (USD per million tokens) for a model not built in, e.g. {"gpt-5.1":{"input":1.25,"output":10}}
# AI_MODEL_RATES=
# Anthropic instead: ANTHROPIC_API_KEY=, AI_PROVIDER=anthropic (defaults claude-sonnet-5 / claude-haiku-4-5)
# ANTHROPIC_API_KEY=
# Per-org daily AI spend cap in USD micros (1,000,000 = $1). ADR 0016.
# AI_DAILY_CAP_USD_MICROS=1000000

# WhatsApp Cloud API (ADR 0017). Nothing is sent until these are set (or MESSAGING_TRANSPORT=mock for demos).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v21.0   # TODO(verify) with Meta at go-live
# MESSAGING_TRANSPORT=mock

# Telegram bazar bot (ADR 0025). Create the bot with @BotFather; the secret is any long random string
# (Telegram sends it back on every update). Development: `pnpm telegram:poll` next to `pnpm dev`.
# Production: `pnpm telegram:webhook https://your-app`.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=      # without the @
# TELEGRAM_WEBHOOK_SECRET=
# Voice notes use speech-to-text from Groq (whisper-large-v3) when GROQ_API_KEY is set and Groq answers
# text or is the only key, else OpenAI (gpt-4o-transcribe). TODO(verify) model and price.
# STT_MODEL=whisper-large-v3
# STT_USD_MICROS_PER_MINUTE=1850

# Social autopilot (ADR 0040). Facebook/Instagram publishing needs a Meta app (developers.facebook.com,
# type Business). Add https://your-app/api/social/meta/callback as a valid OAuth redirect URI.
# META_LOGIN_CONFIG_ID is the "Facebook Login for Business" configuration id, if the app uses one.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# AI-improved dish photos: Cloudflare Workers AI (free 10,000 neurons/day). Token permission: Workers AI.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# Local rendering only (Vercel uses @sparticuz/chromium): path to a Chrome/Chromium executable.
# CHROME_PATH=
# TikTok (ADR 0041): a TikTok developer app (developers.tiktok.com) with Login Kit and Content Posting
# (video.upload + video.publish). Redirect URI: https://your-app/api/social/tiktok/callback.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# "Continue with Facebook" sign-in (ADR 0041). Switch the Facebook provider on in Supabase → Authentication
# → Providers with the same Meta app id/secret, add https://<project>.supabase.co/auth/v1/callback to the
# Meta app's valid OAuth redirect URIs and https://your-app/auth/callback to Supabase's redirect URLs,
# then set this to show the button. Locally: SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET for supabase/config.toml.
# FACEBOOK_SIGN_IN=on
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
