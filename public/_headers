# Cloudflare static-asset headers (OpenNext copies public/ into the Worker's assets).
# Next's build files have a content hash in their names: keep them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The landing page's 3D day (ADR 0064): every URL carries ?v=<hash of the files> (asset-version.ts).
/landing/3d/*
  Cache-Control: public, max-age=31536000, immutable
